{
  "manifest_version": 3,
  "name": "SondeHub Custom Locations",
  "version": "1.6.4",
  "description": "Add and manage local custom markers on the public SondeHub Tracker.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://tracker.sondehub.org/*", "https://sondehub.org/*", "https://amateur.sondehub.org/*"],
      "js": ["src/content/map-overlay-host.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/overlay/overlay.html"],
      "matches": ["https://tracker.sondehub.org/*", "https://sondehub.org/*", "https://amateur.sondehub.org/*"]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sondehub-custom-locations@sondehub-tools.local",
      "data_collection_permissions": {
        "required": ["locationInfo"]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
